{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "ExitPlanMode",
        "hooks": [
          {
            "type": "command",
            "command": "cat \"${CLAUDE_PLUGIN_ROOT}/hooks/plan-approved-context.json\""
          }
        ]
      },
      {
        "matcher": "mcp__(plugin_unpaged_)?unpaged[A-Za-z0-9-]*__agent_listener_key_create",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/monitors/keys.mjs\" hook"
          }
        ]
      }
    ]
  }
}
